# ── LLM providers (fallback chain: Groq → Cerebras → Gemini → OpenRouter) ──
# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Cerebras (OpenAI-compatible endpoint): https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk_...

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...

# OpenRouter (last-resort fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ── Search ─────────────────────────────────────────────────────────────────
# Tavily: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# ── Optional tuning ────────────────────────────────────────────────────────
LLM_MODEL=                    # leave blank to use provider default
LLM_TEMPERATURE=0.2
MAX_SEARCH_RESULTS=5
MAX_VALIDATION_ATTEMPTS=3
CONFIDENCE_THRESHOLD=6
PORT=8000
MAX_TOKEN_BUDGET=24000
MOCK_MODE=false               # set true to skip real API calls (UI testing)

# ── Auth ───────────────────────────────────────────────────────────────────
APP_PASSWORD=                 # set to enable password gate; leave blank for open access

# ── Observability ──────────────────────────────────────────────────────────
# LangSmith: https://smith.langchain.com
LANGSMITH_API_KEY=            # enables tracing of every LangGraph run
LANGSMITH_PROJECT=ares-research

# ── Integrations ───────────────────────────────────────────────────────────
# Slack incoming webhook — posts completed research to a channel
SLACK_WEBHOOK_URL=

# SMTP — for scheduled email report delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ares@localhost
